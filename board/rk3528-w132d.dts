/*
 * ZTE Cloud Computer W132D - Linux v7.1.10 stable baseline.
 *
 * This file intentionally starts from the upstream RK3528 SoC description.
 * Vendor-only rk3528-linux.dtsi nodes are not included here.
 */

/dts-v1/;

#include "rk3528.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/soc/rockchip,vop2.h>

/ {
	model = "ZTE Cloud Computer W132D";
	compatible = "zte,w132d", "rockchip,rk3528";

	/* Mainline DRM master for the experimental RK3528 display path. */
	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <&vop_out>;
		status = "okay";
	};

	aliases {
		ethernet0 = &gmac0;
		mmc0 = &sdhci;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>;
	};

	vcc5v0_host: regulator-5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpios = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
	};
};

/* GM8220S USB2 hub reset is active-low; hold it deasserted. */
&gpio4 {
	usb_hub_reset_hog: usb-hub-reset-hog {
		gpio-hog;
		gpios = <RK_PB5 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-hub-reset";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	/*
	 * The v7.1.10 RK3528 DWCMShc path has no W132D voltage-switch/regulator
	 * description yet.  Keep eMMC in the 3.3 V MMC High-Speed mode (52 MHz)
	 * for bring-up; advertising HS200 makes the driver enter its DLL path and
	 * fail to enumerate the card when it has to fall back below 52 MHz.
	 */
	max-frequency = <52000000>;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&gmac0 {
	clock_in_out = "input";
	status = "okay";
};

/* Use the upstream-style RK3528 USB2 PHY and DWC3 nodes. */
&u2phy {
	status = "okay";
};

&u2phy_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&u2phy_otg {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&combphy {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host";
	phys = <&u2phy_otg>, <&combphy PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	vbus-supply = <&vcc5v0_host>;
	maximum-speed = "super-speed";
	status = "okay";
};

/*
 * RK3528 display bring-up.  The board now selects project-local RK3528
 * HDMI PHY/glue matches; VOP2 register data is still being ported.
 */
&{/soc} {
	vop: vop@ff840000 {
		compatible = "rockchip,rk3528-vop", "rockchip,rk3568-vop";
		reg = <0x0 0xff840000 0x0 0x3000>,
		      <0x0 0xff845000 0x0 0x1000>,
		      <0x0 0xff846400 0x0 0x800>;
		reg-names = "vop", "gamma-lut", "acm-regs";
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru ACLK_VOP>,
				 <&cru HCLK_VOP>,
				 <&cru DCLK_VOP0>,
				 <&cru DCLK_VOP1>,
				 <&cru DCLK_VOP1>;
		clock-names = "aclk", "hclk", "dclk_vp0", "dclk_vp1", "dclk_vp2";
		assigned-clocks = <&cru DCLK_VOP0>;
		assigned-clock-parents = <&inno_hdmiphy_clk>;
		rockchip,grf = <&vo_grf>;
		status = "okay";

		vop_out: ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
					reg = <ROCKCHIP_VOP2_EP_HDMI0>;
					remote-endpoint = <&hdmi_in_vp0>;
				};
			};
		};
	};

	hdmiphy: hdmiphy@ffe00000 {
		compatible = "rockchip,rk3528-hdmi-phy", "rockchip,rk3328-hdmi-phy";
		reg = <0x0 0xffe00000 0x0 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		#phy-cells = <0>;
		clocks = <&cru PCLK_HDMIPHY>, <&xin24m>;
		clock-names = "sysclk", "refclk";
		status = "okay";

		/* RK3528 exposes the pixel clock through the dedicated clk-port. */
		inno_hdmiphy_clk: clk-port {
			#clock-cells = <0>;
			clock-output-names = "clk_hdmiphy_pixel_io";
			status = "okay";
		};
	};

	hdmi: hdmi@ff8d0000 {
		compatible = "rockchip,rk3528-dw-hdmi", "rockchip,rk3328-dw-hdmi";
		reg = <0x0 0xff8d0000 0x0 0x20000>,
		      <0x0 0xff610000 0x0 0x200>;
		interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "hdmi", "hdmi_wakeup";
		clocks = <&cru PCLK_HDMI>,
				 <&cru CLK_SFR_HDMI>,
				 <&cru CLK_CEC_HDMI>,
				 <&inno_hdmiphy_clk>;
		clock-names = "iahb", "isfr", "cec", "dclk_vp0";
		ddc-i2c-scl-high-time-ns = <9625>;
		ddc-i2c-scl-low-time-ns = <10000>;
		reg-io-width = <4>;
		rockchip,grf = <&vo_grf>;
		rockchip,cts-manual;
		pinctrl-names = "default";
		/* PA2 is the RK3528 GPIO HPD workaround input, not HDMI mux 1. */
		pinctrl-0 = <&hdmi_w132d_pins>;
		phys = <&hdmiphy>;
		phy-names = "hdmi";
		hpd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				hdmi_in_vp0: endpoint {
					remote-endpoint = <&vp0_out_hdmi>;
				};
			};

			port@1 {
				reg = <1>;
			};
		};
	};
};

/*
 * RK3528 W132D uses GPIO0_A2 for the HDMI 5 V HPD signal.  The upstream
 * hdmi-pins group muxes PA2 to function 1, which prevents the GPIO consumer
 * and the vendor SNKDET workaround from observing the signal.
 */
&pinctrl {
	hdmi_w132d {
		hdmi_w132d_pins: hdmi-w132d-pins {
			rockchip,pins =
				<0 RK_PA3 1 &pcfg_pull_none>,
				<0 RK_PA2 0 &pcfg_pull_none>,
				<0 RK_PA4 1 &pcfg_pull_none>,
				<0 RK_PA5 1 &pcfg_pull_none>;
		};
	};
};

/* UWE5622 WCN/SDIO nodes are used by the out-of-tree mainline port. */
&sdio1 {
	bus-width = <4>;
	cap-sdio-irq;
	non-removable;
	max-frequency = <50000000>;
	status = "okay";
};

&{/} {
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* Linux 7.1.10's simple pwrseq treats a single reset GPIO as a
		 * reset-controller candidate. Keep both board WCN control lines in
		 * the GPIO array so it uses the intended GPIO fallback path. */
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>,
			      <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <100>;
		status = "okay";
	};

	/* The vendor module's platform drivers use these names. */
	uwe_bsp: uwe-bsp {
		compatible = "unisoc,uwe_bsp";
		sdhci-name = <&sdio1>;
		sdio-ext-int-gpio-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
		bt-wake-host;
		bt-wake-host-gpio-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		bt-reg-on-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		unisoc,btwf-file-name = "/lib/firmware/uwe5622/wcnmodem.bin";
		data-irq;
		blksz-512;
		keep-power-on;
		status = "okay";
	};

	sprd_wlan: sprd-wlan {
		compatible = "sprd,unisoc-wifi";
		status = "okay";
	};

	mtty {
		compatible = "sprd,mtty";
		sprd,name = "ttyBT";
		status = "okay";
	};
};

&sdio1 {
	mmc-pwrseq = <&sdio_pwrseq>;
};
