// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * ZTE Cloud Computer W132D - Linux v7.1.10 stable baseline.
 *
 * This file intentionally starts from the upstream RK3528 SoC description.
 * Vendor-only rk3528-linux.dtsi nodes are not included here.
 */

/dts-v1/;

#include "rk3528.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "ZTE Cloud Computer W132D";
	compatible = "zte,w132d", "rockchip,rk3528";

	/* Mainline DRM master for the experimental RK3528 display path. */
	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <&vop_out>;
		status = "okay";
	};

	aliases {
		ethernet0 = &gmac0;
		mmc0 = &sdhci;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>;
	};

	vcc5v0_host: regulator-5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpios = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
	};
};

/* GM8220S USB2 hub reset is active-low; hold it deasserted. */
&gpio4 {
	usb_hub_reset_hog: usb-hub-reset-hog {
		gpio-hog;
		gpios = <RK_PB5 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-hub-reset";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	/*
	 * Deliberately no fixed-emmc-driver-type: the vendor reference board uses
	 * type 4, but the Samsung 07S000 part fitted here rejects it and the MMC
	 * core falls back to type B anyway.
	 */
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&gmac0 {
	clock_in_out = "input";
	status = "okay";
};

/* Use the upstream-style RK3528 USB2 PHY and DWC3 nodes. */
&u2phy {
	status = "okay";
};

&u2phy_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&u2phy_otg {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&combphy {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host";
	phys = <&u2phy_otg>, <&combphy PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	vbus-supply = <&vcc5v0_host>;
	maximum-speed = "super-speed";
	status = "okay";
};

/*
 * RK3528 display bring-up.  The board now selects project-local RK3528
 * HDMI PHY/glue matches; VOP2 register data is still being ported.
 */
&{/soc} {
	vop: vop@ff840000 {
		compatible = "rockchip,rk3528-vop", "rockchip,rk3568-vop";
		reg = <0x0 0xff840000 0x0 0x3000>,
		      <0x0 0xff845000 0x0 0x1000>,
		      <0x0 0xff846400 0x0 0x800>;
		reg-names = "vop", "gamma-lut", "acm-regs";
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru ACLK_VOP>,
				 <&cru HCLK_VOP>,
				 <&cru DCLK_VOP0>,
				 <&cru DCLK_VOP1>,
				 <&cru DCLK_VOP1>;
		clock-names = "aclk", "hclk", "dclk_vp0", "dclk_vp1", "dclk_vp2";
		assigned-clocks = <&cru DCLK_VOP0>;
		assigned-clock-parents = <&inno_hdmiphy_clk>;
		rockchip,grf = <&vo_grf>;
		status = "okay";

		vop_out: ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
					reg = <ROCKCHIP_VOP2_EP_HDMI0>;
					remote-endpoint = <&hdmi_in_vp0>;
				};
			};
		};
	};

	hdmiphy: hdmiphy@ffe00000 {
		compatible = "rockchip,rk3528-hdmi-phy", "rockchip,rk3328-hdmi-phy";
		reg = <0x0 0xffe00000 0x0 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		#phy-cells = <0>;
		clocks = <&cru PCLK_HDMIPHY>, <&xin24m>;
		clock-names = "sysclk", "refclk";
		status = "okay";

		/* RK3528 exposes the pixel clock through the dedicated clk-port. */
		inno_hdmiphy_clk: clk-port {
			#clock-cells = <0>;
			clock-output-names = "clk_hdmiphy_pixel_io";
			status = "okay";
		};
	};

	hdmi: hdmi@ff8d0000 {
		compatible = "rockchip,rk3528-dw-hdmi", "rockchip,rk3328-dw-hdmi";
		reg = <0x0 0xff8d0000 0x0 0x20000>,
		      <0x0 0xff610000 0x0 0x200>;
		interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "hdmi", "hdmi_wakeup";
		clocks = <&cru PCLK_HDMI>,
				 <&cru CLK_SFR_HDMI>,
				 <&cru CLK_CEC_HDMI>,
				 <&inno_hdmiphy_clk>;
		clock-names = "iahb", "isfr", "cec", "dclk_vp0";
		ddc-i2c-scl-high-time-ns = <9625>;
		ddc-i2c-scl-low-time-ns = <10000>;
		reg-io-width = <4>;
		rockchip,grf = <&vo_grf>;
		rockchip,cts-manual;
		pinctrl-names = "default";
		/* PA2 is the RK3528 GPIO HPD workaround input, not HDMI mux 1. */
		pinctrl-0 = <&hdmi_w132d_pins>;
		phys = <&hdmiphy>;
		phy-names = "hdmi";
		hpd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				hdmi_in_vp0: endpoint {
					remote-endpoint = <&vp0_out_hdmi>;
				};
			};

			port@1 {
				reg = <1>;
			};
		};
	};
};

/*
 * RK3528 W132D uses GPIO0_A2 for the HDMI 5 V HPD signal.  The upstream
 * hdmi-pins group muxes PA2 to function 1, which prevents the GPIO consumer
 * and the vendor SNKDET workaround from observing the signal.
 */
&pinctrl {
	hdmi_w132d {
		hdmi_w132d_pins: hdmi-w132d-pins {
			rockchip,pins =
				<0 RK_PA3 1 &pcfg_pull_none>,
				<0 RK_PA2 0 &pcfg_pull_none>,
				<0 RK_PA4 1 &pcfg_pull_none>,
				<0 RK_PA5 1 &pcfg_pull_none>;
		};
	};
};

/* UWE5622 WCN/SDIO nodes are used by the out-of-tree mainline port. */
&sdio1 {
	bus-width = <4>;
	cap-sdio-irq;
	non-removable;
	max-frequency = <50000000>;
	status = "okay";
};

&{/} {
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* Linux 7.1.10's simple pwrseq treats a single reset GPIO as a
		 * reset-controller candidate. Keep both board WCN control lines in
		 * the GPIO array so it uses the intended GPIO fallback path. */
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>,
			      <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <100>;
		status = "okay";
	};

	/* The vendor module's platform drivers use these names. */
	uwe_bsp: uwe-bsp {
		compatible = "unisoc,uwe_bsp";
		sdhci-name = <&sdio1>;
		sdio-ext-int-gpio-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
		bt-wake-host;
		bt-wake-host-gpio-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		bt-reg-on-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		unisoc,btwf-file-name = "/lib/firmware/uwe5622/wcnmodem.bin";
		data-irq;
		blksz-512;
		keep-power-on;
		status = "okay";
	};

	sprd_wlan: sprd-wlan {
		compatible = "sprd,unisoc-wifi";
		status = "okay";
	};

	mtty {
		compatible = "sprd,mtty";
		sprd,name = "ttyBT";
		status = "okay";
	};
};

&sdio1 {
	mmc-pwrseq = <&sdio_pwrseq>;
};

/*
 * Board hardware that mainline v7.1.10 does not describe for the RK3528 yet.
 *
 * The SoC-level blocks below are added through &{/soc} the same way the
 * display path above is: they are not board wiring, but keeping them in the
 * board file avoids carrying a second rk3528.dtsi patch while the register
 * data is still being validated.  Every register address, interrupt and clock
 * topology comes from this machine's own vendor DTB, with the vendor BSP
 * clock/reset IDs re-mapped onto the mainline rockchip,rk3528-cru.h numbering.
 */
&{/} {
	/*
	 * vdd_cpu drives the CPU rail from PWM1.
	 *
	 * pwm-dutycycle-range is mandatory here.  Mainline pwm-rockchip handles
	 * PWM_POLARITY_INVERSED in the opposite direction from the vendor kernel,
	 * so copying the vendor description verbatim maps a high voltage request
	 * onto a low duty cycle; the board then browns out at 2016 MHz.
	 *
	 * regulator-init-microvolt is deliberately absent: applying a voltage at
	 * probe time, before the mapping direction has been observed, is what
	 * bricked an earlier bring-up attempt.
	 */
	vdd_cpu: regulator-vdd-cpu {
		compatible = "pwm-regulator";
		pwms = <&pwm1 0 5000 1>;
		pwm-dutycycle-range = <100 0>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <746000>;
		regulator-max-microvolt = <1201000>;
		regulator-settling-time-up-us = <250>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&pwm1 {
	status = "okay";
};

/*
 * The mainline opp-table-cpu starts at 1200 MHz.  This machine is idle over
 * 90% of the time, and the SCMI firmware itself reports 408 MHz as the lower
 * bound (clk_min_rate on scmi_clk_cpu), so add the four vendor low steps.
 *
 * All four use 875000 uV rather than the vendor 825000 uV base: the vendor
 * kernel picks a voltage from an nvmem leakage bin and raises everything at or
 * below 1200 MHz to 875000 uV anyway.  Mainline already uses 875000 uV at
 * 1200 MHz, so this reuses a value the tree already trusts.
 */
&cpu_opp_table {
	opp-408000000 {
		opp-hz = /bits/ 64 <408000000>;
		opp-microvolt = <875000 875000 1100000>;
		clock-latency-ns = <40000>;
	};

	opp-600000000 {
		opp-hz = /bits/ 64 <600000000>;
		opp-microvolt = <875000 875000 1100000>;
		clock-latency-ns = <40000>;
	};

	opp-816000000 {
		opp-hz = /bits/ 64 <816000000>;
		opp-microvolt = <875000 875000 1100000>;
		clock-latency-ns = <40000>;
	};

	opp-1008000000 {
		opp-hz = /bits/ 64 <1008000000>;
		opp-microvolt = <875000 875000 1100000>;
		clock-latency-ns = <40000>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
	dynamic-power-coefficient = <147>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
	dynamic-power-coefficient = <147>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
	dynamic-power-coefficient = <147>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
	dynamic-power-coefficient = <147>;
};

&{/soc} {
	watchdog@ffac0000 {
		compatible = "snps,dw-wdt";
		reg = <0x0 0xffac0000 0x0 0x100>;
		clocks = <&cru TCLK_WDT_NS>, <&cru PCLK_WDT_NS>;
		clock-names = "tclk", "pclk";
		resets = <&cru SRST_P_WDT_NS>;
		reset-names = "reset";
		status = "okay";
	};




	tsadc: tsadc@ffad0000 {
		compatible = "rockchip,rk3528-tsadc";
		reg = <0x0 0xffad0000 0x0 0x400>;
		interrupts = <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru CLK_TSADC>, <&cru CLK_TSADC_TSEN>,
			 <&cru PCLK_TSADC>;
		clock-names = "tsadc", "tsadc_tsen", "apb_pclk";
		assigned-clocks = <&cru CLK_TSADC>, <&cru CLK_TSADC_TSEN>;
		assigned-clock-rates = <1200000>, <12000000>;
		resets = <&cru SRST_TSADC>, <&cru SRST_P_TSADC>;
		reset-names = "tsadc", "tsadc-apb";
		rockchip,grf = <&vpu_grf>;
		rockchip,hw-tshut-temp = <120000>;
		rockchip,hw-tshut-mode = <0>;
		rockchip,hw-tshut-polarity = <0>;
		#thermal-sensor-cells = <1>;
		status = "okay";
	};
};

/*
 * Three trips: 95 C and 110 C passive, 120 C critical.  Only the 110 C trip
 * throttles the CPU; the 95 C one is left for the GPU to use first, so the
 * GPU gives up headroom before the CPU does.  Measured peak with four CPUs
 * loaded is 58 C, so this never fires in normal use.
 */
&{/} {
	thermal-zones {
		soc_thermal: soc-thermal {
			polling-delay-passive = <20>;
			polling-delay = <1000>;
			thermal-sensors = <&tsadc 0>;

			trips {
				soc_alert0: trip-point-0 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_alert1: trip-point-1 {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc-crit {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&soc_alert1>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};
	};
};

&{/} {
	/*
	 * vdd_logic supplies the GPU rail from PWM2.  Without it the rail stays
	 * at the 703 mV left by U-Boot and lima refuses to probe with
	 * "no regulator (mali) found"; the 700/800 MHz OPPs would be undervolted.
	 */
	vdd_logic: regulator-vdd-logic {
		compatible = "pwm-regulator";
		pwms = <&pwm2 0 5000 1>;
		pwm-dutycycle-range = <100 0>;
		regulator-name = "vdd_logic";
		regulator-min-microvolt = <703000>;
		regulator-max-microvolt = <1006000>;
		regulator-settling-time-up-us = <250>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&pwm2 {
	status = "okay";
};

/*
 * Mali-450 needs no driver change - mainline lima already matches
 * "arm,mali-450" - only the rail and the enable.  With vdd_logic connected all
 * five OPPs (300/500/600/700/800 MHz) run; 800 MHz peaks at 57 C against a
 * 95 C trip.
 */
&gpu {
	mali-supply = <&vdd_logic>;
	#cooling-cells = <2>;
	status = "okay";
};

/*
 * Hang the GPU off the 95 C trip that the SoC zone leaves free, so a GPU
 * downclock - unnoticeable on this headless machine - happens before the CPU
 * is throttled at 110 C.  The GPU peaks at 57 C at 800 MHz, so this is
 * configuration completeness rather than a fix for an observed problem.
 */
&soc_thermal {
	cooling-maps {
		map1 {
			trip = <&soc_alert0>;
			cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			contribution = <1024>;
		};
	};
};

&{/soc} {
	/*
	 * The vendor DTB uses the BSP-only "rockchip,iommu-v2"; mainline reaches
	 * the same v2 ops through "rockchip,rk3568-iommu".
	 */
	vdec_mmu: iommu@ff740800 {
		compatible = "rockchip,rk3568-iommu";
		reg = <0x0 0xff740800 0x0 0x40>,
		      <0x0 0xff740900 0x0 0x40>;
		interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>;
		clock-names = "aclk", "iface";
		#iommu-cells = <0>;
		status = "okay";
	};




	/*
	 * No power-domains on purpose.  rk3528.dtsi leaves
	 * power-domain@RK3528_PD_RKVDEC disabled, so referencing it makes both
	 * devices fail with deferred probe timeouts.  The vendor DTB does not
	 * use a power domain here either: the RK3528 vdec domain is defined with
	 * a zero power mask, i.e. bus idle handshake only, permanently powered.
	 */
	vdec: video-codec@ff740000 {
		compatible = "rockchip,rk3528-vdec";
		reg = <0x0 0xff740000 0x0 0x100>,
		      <0x0 0xff740100 0x0 0x400>;
		reg-names = "link", "function";
		interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>,
			 <&cru CLK_HEVC_CA_RKVDEC>;
		clock-names = "axi", "ahb", "hevc_cabac";
		assigned-clocks = <&cru ACLK_RKVDEC>, <&cru CLK_HEVC_CA_RKVDEC>;
		assigned-clock-rates = <340000000>, <600000000>;
		iommus = <&vdec_mmu>;
		sram = <&vdec_sram>;
		status = "okay";
	};




	/*
	 * On-chip SRAM used for the decoder row cache.  The child must carry
	 * "pool" or drivers/misc/sram.c never creates a named gen_pool for it.
	 */
	sram@fe480000 {
		compatible = "mmio-sram";
		reg = <0x0 0xfe480000 0x0 0xc000>;
		ranges = <0x0 0x0 0xfe480000 0xc000>;
		#address-cells = <1>;
		#size-cells = <1>;

		vdec_sram: rkvdec-sram@0 {
			reg = <0x0 0xc000>;
			pool;
		};
	};
};

&{/} {
	/* SARADC reference; channel 2 distinguishes headphone from headset. */
	vdd_1v8_s3: regulator-vdd-1v8-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v8_s3";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};




	/*
	 * Playback: SAI2 -> on-chip ACODEC (DAC only) -> LINEOUT -> 3.5 mm jack.
	 * The vendor rockchip,multicodecs-card has no mainline equivalent;
	 * simple-audio-card covers everything this path needs.
	 */
	acodec_sound: acodec-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rk3528-acodec";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,bitclock-master = <&acodec_sound_cpu>;
		simple-audio-card,frame-master = <&acodec_sound_cpu>;
		simple-audio-card,hp-det-gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_LOW>;
		simple-audio-card,widgets = "Headphone", "Headphones";
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;

		acodec_sound_cpu: simple-audio-card,cpu {
			sound-dai = <&sai2>;
		};

		simple-audio-card,codec {
			sound-dai = <&acodec>;
		};
	};




	/*
	 * Capture: ES7202 analog-to-PDM bridge -> PDM SDI2.  PDM is a
	 * unidirectional data line, so this card carries no format/mclk-fs.
	 */
	es7202_sound: es7202-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,pdm-mic-array";

		simple-audio-card,cpu {
			sound-dai = <&pdm>;
		};

		simple-audio-card,codec {
			sound-dai = <&es7202>;
		};
	};
};

&saradc {
	vref-supply = <&vdd_1v8_s3>;
	status = "okay";
};

&i2c2 {
	status = "okay";

	/* The vendor codec driver matches on this compatible string. */
	es7202: es7202@30 {
		compatible = "ES7202_PDM_ADC_1";
		reg = <0x30>;
		#sound-dai-cells = <0>;
		status = "okay";
	};
};

&pinctrl {
	headphone {
		/*
		 * GPIO4_A3 has no external pull-up, so without the internal one
		 * the detect line reads low forever and a headphone always looks
		 * inserted.  The vendor hp-det group uses pcfg_pull_up too.
		 */
		hp_det: hp-det {
			rockchip,pins = <4 RK_PA3 0 &pcfg_pull_up>;
		};
	};
};

&{/soc} {
	/*
	 * SAI2 is wired to the on-chip codec, so it has no pins.  Mainline only
	 * matches rockchip,rk3576-sai, but the RK3528 register layout is
	 * identical and the driver reads SAI_VERSION at runtime; the rk3576
	 * fallback is kept so an unpatched driver still binds.
	 */
	sai2: sai@ffb90000 {
		compatible = "rockchip,rk3528-sai", "rockchip,rk3576-sai";
		reg = <0x0 0xffb90000 0x0 0x1000>;
		interrupts = <GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru MCLK_SAI_I2S2>, <&cru HCLK_SAI_I2S2>;
		clock-names = "mclk", "hclk";
		dmas = <&dmac 4>;
		dma-names = "tx";
		resets = <&cru SRST_M_SAI_I2S2>, <&cru SRST_H_SAI_I2S2>;
		reset-names = "m", "h";
		#sound-dai-cells = <0>;
		status = "okay";
	};




	acodec: acodec@ffe10000 {
		compatible = "rockchip,rk3528-codec";
		reg = <0x0 0xffe10000 0x0 0x1000>;
		clocks = <&cru PCLK_ACODEC>, <&cru MCLK_ACODEC_TX>;
		clock-names = "pclk", "mclk";
		resets = <&cru SRST_P_ACODEC>;
		reset-names = "acodec";
		/* External amplifier enable. */
		pa-ctl-gpios = <&gpio4 RK_PC3 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		status = "okay";
	};




	pdm: pdm@ffbb0000 {
		compatible = "rockchip,rk3528-pdm", "rockchip,rk3568-pdm";
		reg = <0x0 0xffbb0000 0x0 0x1000>;
		clocks = <&cru MCLK_PDM>, <&cru HCLK_PDM>;
		clock-names = "pdm_clk", "pdm_hclk";
		dmas = <&dmac 6>;
		dma-names = "rx";
		pinctrl-names = "default";
		pinctrl-0 = <&pdm_clk1>, <&pdm_sdi2>;
		/* Only SDI2 is populated; map it onto path0. */
		rockchip,path-map = <2 1 0 3>;
		#sound-dai-cells = <0>;
		status = "okay";
	};
};

&{/} {
	/*
	 * The vendor DTB drives the IR receiver with rockchip,remotectl-pwm,
	 * which captures pulse widths in PWM3 hardware.  Mainline has neither
	 * that driver nor capture support in pwm-rockchip, so the same pin is
	 * muxed back to plain GPIO and decoded by gpio-ir-receiver.  pwm3 must
	 * stay disabled for the pin to be free.
	 *
	 * No wakeup-source: this board only ever does software standby, so the
	 * pin never participates in a hardware suspend/resume path.
	 */
	ir_receiver: ir-receiver {
		compatible = "gpio-ir-receiver";
		gpios = <&gpio4 RK_PC6 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

&{/} {
	/*
	 * Panel indicators.  Do not use the legacy "label" property here:
	 * leds-gpio only passes an fwnode to the LED core when a child has no
	 * label, and led-class only reads linux,default-trigger from that
	 * fwnode - with a label every trigger silently ends up as [none].
	 */
	leds {
		compatible = "gpio-leds";

		led-net-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio4 RK_PB7 GPIO_ACTIVE_HIGH>;
			default-state = "off";
			linux,default-trigger = "none";
		};

		led-net-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_HIGH>;
			default-state = "off";
			linux,default-trigger = "none";
		};

		led-pwr-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
			linux,default-trigger = "none";
		};

		led-pwr-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_HIGH>;
			default-state = "on";
			linux,default-trigger = "none";
		};
	};
};

&{/firmware} {
	/*
	 * OP-TEE is already running: our U-Boot FIT loads it at 0x08400000, and
	 * U-Boot removes that range from /memory before entering Linux, so the
	 * kernel never maps it.  Only the DT node was missing, which is why
	 * /dev/tee0 never appeared.
	 */
	optee {
		compatible = "linaro,optee-tz";
		method = "smc";
	};
};

&{/reserved-memory} {
	/*
	 * Crash log storage that survives a warm reset - it is ordinary DRAM in
	 * the firmware-reserved low 2 MB that neither Linux nor the TPL touches.
	 * It does not survive a power cycle.
	 *
	 * 0x110000..0x1effff is free: the ATF images end at 0xa2f71 and the SCMI
	 * shmem sits at 0x10f000+0x100.
	 *
	 * record-size and console-size must be powers of two; ramoops rounds
	 * anything else down without a diagnostic.
	 */
	ramoops@110000 {
		compatible = "ramoops";
		reg = <0x0 0x110000 0x0 0xe0000>;
		record-size = <0x10000>;
		console-size = <0x40000>;
		pmsg-size = <0x0>;
		ftrace-size = <0x0>;
		/* KMSG_DUMP_EMERG, so emergency_restart() is captured too. */
		max-reason = <3>;
	};
};
