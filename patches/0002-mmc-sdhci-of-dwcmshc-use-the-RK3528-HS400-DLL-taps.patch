From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wenziwanka <tech@wenziwanka.com>
Date: Wed, 2 Sep 2026 06:07:24 +0000
Subject: [PATCH] mmc: sdhci-of-dwcmshc: use the RK3528 HS400 DLL taps

The revision==1 HS400 path hardcodes the RK3588 DLL taps (10/8/4).  The
RK3528 needs 6/6/3; with the RK3588 values the eMMC does not enumerate
at HS400 at all.  The correct values come from the GPL-2.0 Rockchip BSP
(drivers/mmc/host/sdhci-of-dwcmshc.c, rk3528_drvdata).

Configure the RK3528 using the dedicated rockchip_emmc_data structure,
matching the vendor DLL taps (12/6/6/3) and add the compatible match.

Tested on a ZTE Cloud Computer W132D (RK3528): eMMC enumerates and runs
at HS400 with enhanced strobe and command queueing enabled.

Signed-off-by: wenziwanka <tech@wenziwanka.com>
---
 drivers/mmc/host/sdhci-of-dwcmshc.c | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/drivers/mmc/host/sdhci-of-dwcmshc.c b/drivers/mmc/host/sdhci-of-dwcmshc.c
index b3ff0fc..b02ab5d 100644
--- a/drivers/mmc/host/sdhci-of-dwcmshc.c
+++ b/drivers/mmc/host/sdhci-of-dwcmshc.c
@@ -2233,6 +2233,35 @@ static const struct cqhci_host_ops rk35xx_cqhci_ops = {
 	.set_tran_desc	= dwcmshc_set_tran_desc,
 };
 
+/* RK3528 DLL settings from the Rockchip vendor driver. */
+static const struct rockchip_emmc_data rk3528_emmc_data = {
+	.hs200_tx_tapnum = 12,
+	.hs400_tx_tapnum = 6,
+	.hs400_cmd_tapnum = 6,
+	.hs400_strbin_tapnum = 3,
+	.ddr50_strbin_delay_num = 10,
+	.dll_cmd_out = true,
+	.tap_value_sel = true,
+	.allow_low_clock = true,
+};
+
+static const struct rockchip_pltfm_data sdhci_dwcmshc_rk3528_pdata = {
+	.dwcmshc_pdata = {
+		.pdata = {
+			.ops = &sdhci_dwcmshc_rk35xx_ops,
+			.quirks = SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN |
+				  SDHCI_QUIRK_BROKEN_TIMEOUT_VAL,
+			.quirks2 = SDHCI_QUIRK2_PRESET_VALUE_BROKEN |
+				   SDHCI_QUIRK2_CLOCK_DIV_ZERO_BROKEN,
+		},
+		.cqhci_host_ops = &rk35xx_cqhci_ops,
+		.init = dwcmshc_rk35xx_init,
+		.postinit = dwcmshc_rk35xx_postinit,
+	},
+	.revision = 1,
+	.emmc_data = &rk3528_emmc_data,
+};
+
 /* RK3562 DLL settings from the Rockchip vendor driver. */
 static const struct rockchip_emmc_data rk3562_emmc_data = {
 	.hs200_tx_tapnum = 12,
@@ -2477,6 +2506,10 @@ static const struct of_device_id sdhci_dwcmshc_dt_ids[] = {
 		.compatible = "canaan,k230-sdio",
 		.data = &k230_sdio_data.dwcmshc_pdata,
 	},
+	{
+		.compatible = "rockchip,rk3528-dwcmshc",
+		.data = &sdhci_dwcmshc_rk3528_pdata,
+	},
 	{
 		.compatible = "rockchip,rk3562-dwcmshc",
 		.data = &sdhci_dwcmshc_rk3562_pdata,
