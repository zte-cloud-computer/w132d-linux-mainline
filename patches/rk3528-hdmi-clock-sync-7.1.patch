diff --git a/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c b/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
--- a/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw_hdmi-rockchip.c
@@ -381,13 +381,24 @@ static void dw_hdmi_rockchip_encoder_mode_set(struct drm_encoder *encoder,
 	struct rockchip_hdmi *hdmi = to_rockchip_hdmi(encoder);
 
 	/*
-	 * RK3528's HDMI pixel PLL is the VOP dclk_vp0 clock. The VOP CRTC
-	 * owns its parent/rate programming; changing it here causes a second
-	 * PLL reconfiguration during one atomic modeset and can retrain HDMI.
+	 * RK3528's HDMI pixel PLL is also the parent of VOP dclk_vp0. Keep the
+	 * PHY provider synchronized with the final adjusted CRTC clock. The VOP
+	 * path programs the same rate later; repeating the same rate is harmless,
+	 * while leaving the provider at an old bootloader rate produces a valid
+	 * framebuffer driven with a mismatched TMDS clock and visible flicker.
 	 */
 	dev_info(hdmi->dev,
-		 "RK3528 HDMI mode_set %ux%u@%u clock=%d kHz vop_dclk=%lu Hz (VOP-owned)\n",
+		 "RK3528 HDMI mode_set %ux%u@%u clock=%d kHz phy_dclk_before=%lu Hz\n",
 		 adj_mode->hdisplay, adj_mode->vdisplay,
 		 drm_mode_vrefresh(adj_mode), adj_mode->clock,
-		 hdmi->hdmiphy_clk ? clk_get_rate(hdmi->hdmiphy_clk) : 0UL);
+		 hdmi->hdmiphy_clk ? clk_get_rate(hdmi->hdmiphy_clk) : 0UL);
+
+	if (hdmi->hdmiphy_clk) {
+		unsigned long clock = adj_mode->crtc_clock * 1000UL;
+		int ret = clk_set_rate(hdmi->hdmiphy_clk, clock);
+
+		dev_info(hdmi->dev,
+			 "RK3528 HDMI phy_dclk requested=%lu Hz actual=%lu Hz ret=%d\n",
+			 clock, clk_get_rate(hdmi->hdmiphy_clk), ret);
+	}
 }
