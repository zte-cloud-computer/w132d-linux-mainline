+	if (hdmi->chip_data == &rk3528_chip_data && hdmi->hpd_gpio) {
+		struct resource *res;
+
+		hdmi->hpd_irq = gpiod_to_irq(hdmi->hpd_gpio);
+		if (hdmi->hpd_irq < 0)
+			return hdmi->hpd_irq;
+
+		res = platform_get_resource(to_platform_device(hdmi->dev),
+					    IORESOURCE_MEM, 1);
+		if (!res)
+			return dev_err_probe(hdmi->dev, -ENODEV,
+					"failed to get RK3528 GPIO registers\n");
+
+		hdmi->gpio_base = devm_ioremap(hdmi->dev, res->start,
+					       resource_size(res));
+		if (!hdmi->gpio_base)
+			return dev_err_probe(hdmi->dev, -ENOMEM,
+					"failed to map RK3528 GPIO registers\n");
+
+		rk3528_gpio_hpd_sync(hdmi);
+		ret = devm_request_threaded_irq(hdmi->dev, hdmi->hpd_irq, NULL,
+						rk3528_hpd_irq,
+						IRQF_TRIGGER_RISING |
+						IRQF_TRIGGER_FALLING |
+						IRQF_ONESHOT,
+						"hdmi-hpd", hdmi);
+		if (ret)
+			return dev_err_probe(hdmi->dev, ret,
+					"failed to request HPD IRQ\n");
+	}
+
