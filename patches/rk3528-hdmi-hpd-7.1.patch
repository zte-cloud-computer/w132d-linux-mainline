 static struct rockchip_hdmi_chip_data rk3528_chip_data;
 
+static void rk3528_gpio_hpd_sync(struct rockchip_hdmi *hdmi)
+{
+	int value;
+
+	if (!hdmi->hpd_gpio)
+		return;
+
+	/* GPIO0_A2 input enable is controlled by its output data bit. */
+	if (hdmi->gpio_base)
+		writel(FIELD_PREP_WM16(RK3528_GPIO0_A2_DR, 1),
+		       hdmi->gpio_base + RK3528_GPIO_SWPORT_DR_L);
+
+	regmap_write(hdmi->regmap, RK3528_VO_GRF_HDMI_MASK,
+		     FIELD_PREP_WM16(RK3528_HDMI_SNKDET_SEL, 1) |
+		     FIELD_PREP_WM16(RK3528_HDMI_SDAIN_MSK, 1) |
+		     FIELD_PREP_WM16(RK3528_HDMI_SCLIN_MSK, 1));
+
+	value = gpiod_get_value(hdmi->hpd_gpio);
+	if (value < 0)
+		return;
+
+	regmap_write(hdmi->regmap, RK3528_VO_GRF_HDMI_MASK,
+		     FIELD_PREP_WM16(RK3528_HDMI_SNKDET, value ? 1 : 0));
+}
+
+static irqreturn_t rk3528_hpd_irq(int irq, void *data)
+{
+	struct rockchip_hdmi *hdmi = data;
+	int value = gpiod_get_value(hdmi->hpd_gpio);
+
+	if (value >= 0) {
+		regmap_write(hdmi->regmap, RK3528_VO_GRF_HDMI_MASK,
+			     FIELD_PREP_WM16(RK3528_HDMI_SNKDET, value ? 1 : 0));
+		if (hdmi->encoder.encoder.dev)
+			drm_helper_hpd_irq_event(hdmi->encoder.encoder.dev);
+	}
+
+	return IRQ_HANDLED;
+}
