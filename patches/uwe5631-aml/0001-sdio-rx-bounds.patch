diff --git a/BT/tty-sdio/sdio.c b/BT/tty-sdio/sdio.c
index 63a185e..453f11c 100644
--- a/BT/tty-sdio/sdio.c
+++ b/BT/tty-sdio/sdio.c
@@ -75,23 +75,51 @@ static int marlin_sdio_tx_cb(int chn, struct mbuf_t *head, struct mbuf_t *tail,
 
 static int marlin_sdio_rx_cb(int chn, struct mbuf_t *head, struct mbuf_t *tail, int num)
 {
-    int block_size;
+    int block_size = 0;
+    int ret = 0;
 
-    block_size = ((head->buf[2] & 0x7F) << 9) + (head->buf[1] << 1) + (head->buf[0] >> 7);
     BT_VER("%s +++\n", __func__);
 
-    if (bt_data_if_cb == NULL)
+    if (!head || !tail || num <= 0 || !head->buf || head->len <= 0)
+    {
+        pr_err("BT_RX_BOUNDS invalid list head=%p tail=%p num=%d\n",
+               head, tail, num);
+        ret = -EINVAL;
+        goto recycle;
+    }
+
+    block_size = ((head->buf[2] & 0x7F) << 9) +
+                 (head->buf[1] << 1) + (head->buf[0] >> 7);
+    /* head->len is the payload length; the public header is extra. */
+    if (block_size <= 0 || block_size > head->len)
     {
-        return -1;
+        pr_err("BT_RX_BOUNDS reject block=%d mbuf_len=%d num=%d\n",
+               block_size, head->len, num);
+        ret = -EPROTO;
+        goto recycle;
+    }
+
+    if (bt_data_if_cb == NULL || bt_data_if_cb->recv == NULL)
+    {
+        pr_err("BT_RX_BOUNDS receive callback unavailable\n");
+        ret = -ENODEV;
+        goto recycle;
     }
 
     BT_VERDUMP((unsigned char *)head->buf + BT_SDIO_HEAD_LEN, block_size);
 
     bt_data_if_cb->recv((unsigned char *)head->buf + BT_SDIO_HEAD_LEN, block_size);
-    sprdwcn_bus_push_list(chn, head, tail, num);
+
+recycle:
+    if (head && tail && num > 0 &&
+        sprdwcn_bus_push_list(chn, head, tail, num))
+    {
+        pr_err("BT_RX_BOUNDS failed to recycle RX list\n");
+        return -EIO;
+    }
     BT_VER("%s ---\n", __func__);
 
-    return 0;
+    return ret;
 }
 
 
diff --git a/BT/tty-sdio/sitm.c b/BT/tty-sdio/sitm.c
