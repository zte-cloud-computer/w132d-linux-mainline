                 memcpy(rd->buffer,
                        rd->preamble,
                        rd->index);
@@ -113,6 +137,16 @@ void parse_frame(data_ready_cb data_ready, frame_complete_cb frame_complete)
             break;
 
         case BODY:
+            if (rd->index >= HCI_HAL_SERIAL_BUFFER_SIZE ||
+                rd->bytes_remaining >
+                HCI_HAL_SERIAL_BUFFER_SIZE - rd->index)
+            {
+                pr_err("SITM_BOUNDS invalid body index=%u remaining=%u\n",
+                       rd->index, rd->bytes_remaining);
