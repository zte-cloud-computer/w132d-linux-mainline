--- a/Makefile
+++ b/Makefile
@@ -6,7 +6,7 @@
 
 #ccflags-y += -I$(srctree)/drivers/net/wireless/uwe5622/sprdwcn/include
 ccflags-y += -I$(CURFOLDER)/include
-#ccflags-y += -DUSE_DTS
+ccflags-y += -DUSE_DTS
 
 # sprdbt_tty calls symbols EXPORT_SYMBOL'd by the BSP module
 # (get_wcn_bus_ops, start_marlin/stop_marlin, marlin_set_wakeup/_sleep,
--- a/rfkill.c
+++ b/rfkill.c
@@ -89,7 +89,11 @@ int rfkill_bluetooth_init(struct platform_device *pdev)
 
     /* userspace cannot take exclusive control */
 
-    rfkill_init_sw_state(bt_rfk, true); //default power off
+    /*
+     * The tty owner controls WCN power. Do not leave BlueZ seeing a stale
+     * software block after mtty_open() has powered the Bluetooth subsystem.
+     */
+    rfkill_init_sw_state(bt_rfk, false);
 
     rc = rfkill_register(bt_rfk);
 
--- a/tty.c
+++ b/tty.c
@@ -754,4 +754,4 @@ MODULE_DESCRIPTION("Unisoc marlin tty driver");
  * softdep is a belt-and-suspenders declaration for insmod-based or
  * other loading paths that don't consult depmod's dependency graph.
  */
-MODULE_SOFTDEP("pre: uwe5621_bsp_sdio");
+MODULE_SOFTDEP("pre: uwe5622_bsp_sdio");
