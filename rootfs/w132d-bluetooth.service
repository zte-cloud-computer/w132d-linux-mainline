# SPDX-License-Identifier: MIT
[Unit]
Description=W132D UWE5622 Bluetooth HCI transport
After=systemd-modules-load.service local-fs.target
Before=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/w132d-btattach /dev/ttyBT0
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
