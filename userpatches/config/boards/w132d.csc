# SPDX-License-Identifier: MIT
# ZTE W132D hardware declaration. Build policy lives in the w132d extension.
BOARD_NAME="ZTE Cloud Computer W132D"
BOARD_VENDOR="zte"
BOARDFAMILY="rk35xx"
BOARD_MAINTAINER="wenziwanka"
INTRODUCED="2026"
BOOT_SOC="rk3528"
KERNEL_TARGET="edge"
FULL_DESKTOP="no"
BOOT_FDT_FILE="rockchip/rk3528-w132d.dtb"
BOOTCONFIG="generic-rk3528_defconfig"
BOOT_SCENARIO="spl-blobs"
SERIALCON="ttyS0"
SRC_EXTLINUX="yes"
SRC_CMDLINE="rootwait rootfstype=ext4 console=ttyS0,115200 console=tty1 consoleblank=0 loglevel=7"
PACKAGE_LIST_BOARD="bluez rfkill ir-keytable python3-dbus python3-gi alsa-utils"
enable_extension "w132d"
