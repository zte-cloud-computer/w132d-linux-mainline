config SPARD_WLAN_SUPPORT
	bool "W132D UWE5621DS SDIO support"
	depends on ARCH_ROCKCHIP && MMC && BT && CFG80211
	select RK_WIFI_DEVICE_UWE5621DS if ARCH_ROCKCHIP
	help
	  This is support for spreadtrum wireless chip.

if SPARD_WLAN_SUPPORT
source "drivers/net/wireless/uwe5621ds/unisocwcn/Kconfig"
source "drivers/net/wireless/uwe5621ds/unisocwifi/Kconfig"
source "drivers/net/wireless/uwe5621ds/tty-sdio/Kconfig"
endif
