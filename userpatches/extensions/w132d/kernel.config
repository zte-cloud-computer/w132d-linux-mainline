CONFIG_SPARD_WLAN_SUPPORT=y
CONFIG_RK_WIFI_DEVICE_UWE5621DS=y
# CONFIG_RK_WIFI_DEVICE_UWE5621 is not set
# CONFIG_AW_WIFI_DEVICE_UWE5622 is not set
CONFIG_WLAN_UWE5621DS=m
CONFIG_TTY_OVERY_SDIO=m
CONFIG_TTY_OVERY_SDIO_HCI=y
# CONFIG_WCN_BSP_DRIVER_BUILDIN is not set
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_SMP=y
CONFIG_CFG80211=m
CONFIG_RFKILL=y
CONFIG_SND_SOC_RK3528=m
CONFIG_SND_SOC_ES7202=m
CONFIG_SND_SOC_ROCKCHIP_SAI=m
CONFIG_SND_SOC_ROCKCHIP_PDM=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=m
CONFIG_PHY_ROCKCHIP_INNO_HDMI=m
CONFIG_VIDEO_ROCKCHIP_VDEC=m
CONFIG_VIDEO_ROCKCHIP_VDEC2=m
CONFIG_DRM_LIMA=m
CONFIG_IR_GPIO_CIR=m
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_TEE=y
CONFIG_OPTEE=y
CONFIG_SRAM=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR_PWM=y
CONFIG_SND_SOC=y
CONFIG_MODULES=y
