From cdac979208b0d15099c431135d80450ff8d13bdc Mon Sep 17 00:00:00 2001
From: wenziwanka <tech@wenziwanka.com>
Date: Tue, 1 Sep 2026 15:09:01 +0000
Subject: [PATCH 4/5] ASoC: rockchip: add the RK3528 audio codec and the ES7202
 PDM ADC

The RK3528 has an on-chip DAC-only audio codec ("acodec") and boards
commonly pair it with an Everest ES7202 analogue-microphone-to-PDM
bridge for capture.  Neither driver exists in mainline.

Both drivers are taken from the GPL-2.0 Rockchip BSP
(armbian/linux-rockchip, rk-6.1-rkr5).  The changes here are limited to
6.1 -> 7.x API adaptation:

  - of_gpio.h was removed in 6.15; both drivers only use the gpiod_*
    descriptor API, so include linux/gpio/consumer.h instead
  - SND_SOC_DAIFMT_CBS_CFS / CBM_CFM were dropped after 6.7; use the
    clock-provider naming (CBC_CFC / CBP_CFP)
  - platform_driver::remove returns void since 6.11

Register sequences, timings and default values are unchanged.

Tested on a ZTE Cloud Computer W132D (RK3528): 3.5 mm playback through
the on-chip codec and headset-microphone capture through the ES7202 both
work.

Signed-off-by: wenziwanka <tech@wenziwanka.com>
---
 sound/soc/codecs/Kconfig          |   21 +
 sound/soc/codecs/Makefile         |    5 +
 sound/soc/codecs/es7202.c         | 1157 +++++++++++++++++++++++++++++
 sound/soc/codecs/es7202.h         |  102 +++
 sound/soc/codecs/rk3528_codec.c   |  783 +++++++++++++++++++
 sound/soc/codecs/rk3528_codec.h   |  236 ++++++
 sound/soc/rockchip/rockchip_sai.c |    2 +
 7 files changed, 2306 insertions(+)
 create mode 100644 sound/soc/codecs/es7202.c
 create mode 100644 sound/soc/codecs/es7202.h
 create mode 100644 sound/soc/codecs/rk3528_codec.c
 create mode 100644 sound/soc/codecs/rk3528_codec.h

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 9bf869e..7b7df8d 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -2932,4 +2932,25 @@ config SND_SOC_LPASS_TX_MACRO
 	select SND_SOC_LPASS_MACRO_COMMON
 	tristate "Qualcomm TX Macro in LPASS(Low Power Audio SubSystem)"
 
+config SND_SOC_RK3528
+	tristate "Rockchip RK3528 internal audio codec"
+	depends on ARCH_ROCKCHIP || COMPILE_TEST
+	select REGMAP_MMIO
+	help
+	  RK3528 internal audio codec with a stereo line-output DAC.
+	  On the W132D this drives the 3.5 mm audio jack.
+
+config SND_SOC_ES7202
+	tristate "Everest Semi ES7202 PDM ADC"
+	depends on I2C
+	help
+	  ES7202 microphone ADC with I2C control and PDM audio data.
+
+config SND_SOC_ES7202_MIC_MAX_CHANNELS
+	int "ES7202 microphone channels"
+	depends on SND_SOC_ES7202
+	default 2
+	help
+	  Each ES7202 provides two channels. The W132D has one device.
+
 endmenu
