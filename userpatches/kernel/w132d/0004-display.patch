+
+/*
+ * The RK3528 HDMI controller does not sense hot-plug on its own pad. The
+ * level is read from a GPIO and mirrored into the VO GRF sink-detect bit,
+ * which the controller then sees as its regular HPD input.
+ */
+static void dw_hdmi_rk3528_set_snkdet(struct rockchip_hdmi *hdmi)
+{
+	int value = gpiod_get_value_cansleep(hdmi->hpd_gpio);
+
+	if (value < 0)
+		return;
+
+	regmap_write(hdmi->regmap, RK3528_VO_GRF_HDMI_MASK,
+		     FIELD_PREP_WM16(RK3528_HDMI_SNKDET, value ? 1 : 0));
+}
+
+static irqreturn_t dw_hdmi_rk3528_hpd_irq(int irq, void *data)
+{
+	dw_hdmi_rk3528_set_snkdet(data);
+
+	return IRQ_HANDLED;
 }
 
+static int dw_hdmi_rk3528_init_hpd(struct rockchip_hdmi *hdmi)
+{
+	struct device *dev = hdmi->dev;
+	int irq, ret;
+
+	/*
+	 * The input path of the HPD pad is only enabled while its GPIO output
+	 * data bit is set, so request it high first and then turn it around.
+	 */
+	hdmi->hpd_gpio = devm_gpiod_get_optional(dev, "hpd", GPIOD_OUT_HIGH);
+	if (IS_ERR(hdmi->hpd_gpio))
+		return dev_err_probe(dev, PTR_ERR(hdmi->hpd_gpio),
+				     "failed to get HPD GPIO\n");
+	if (!hdmi->hpd_gpio)
+		return 0;
+
+	ret = gpiod_direction_input(hdmi->hpd_gpio);
+	if (ret)
+		return ret;
+
+	irq = gpiod_to_irq(hdmi->hpd_gpio);
+	if (irq < 0)
+		return irq;
+
+	ret = devm_request_threaded_irq(dev, irq, NULL, dw_hdmi_rk3528_hpd_irq,
+					IRQF_TRIGGER_RISING |
+					IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+					"hdmi-hpd", hdmi);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request HPD irq\n");
+
+	return 0;
+}
+
+static void dw_hdmi_rk3528_setup_hpd(struct dw_hdmi *dw_hdmi, void *data)
+{
+	struct rockchip_hdmi *hdmi = data;
+
+	dw_hdmi_phy_setup_hpd(dw_hdmi, data);
+
+	regmap_write(hdmi->regmap, RK3528_VO_GRF_HDMI_MASK,
+		     FIELD_PREP_WM16(RK3528_HDMI_SNKDET_SEL,
+				     hdmi->hpd_gpio ? 1 : 0) |
+		     FIELD_PREP_WM16(RK3528_HDMI_SDAIN_MSK, 1) |
+		     FIELD_PREP_WM16(RK3528_HDMI_SCLIN_MSK, 1));
+
+	if (hdmi->hpd_gpio)
+		dw_hdmi_rk3528_set_snkdet(hdmi);
+}
