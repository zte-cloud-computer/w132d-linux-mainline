From: W132D maintainers <tech@wenziwanka.com>
Subject: [PATCH] dt-bindings: describe W132D hardware and audio fallbacks

diff --git a/Documentation/devicetree/bindings/sound/rockchip,rk3576-sai.yaml b/Documentation/devicetree/bindings/sound/rockchip,rk3576-sai.yaml
--- a/Documentation/devicetree/bindings/sound/rockchip,rk3576-sai.yaml
+++ b/Documentation/devicetree/bindings/sound/rockchip,rk3576-sai.yaml
@@ -18,7 +18,11 @@
 
 properties:
   compatible:
-    const: rockchip,rk3576-sai
+    oneOf:
+      - const: rockchip,rk3576-sai
+      - items:
+          - const: rockchip,rk3528-sai
+          - const: rockchip,rk3576-sai
 
   reg:
     maxItems: 1
diff --git a/Documentation/devicetree/bindings/sound/rockchip,pdm.yaml b/Documentation/devicetree/bindings/sound/rockchip,pdm.yaml
--- a/Documentation/devicetree/bindings/sound/rockchip,pdm.yaml
+++ b/Documentation/devicetree/bindings/sound/rockchip,pdm.yaml
@@ -18,16 +18,30 @@
 
 allOf:
   - $ref: dai-common.yaml#
+  # RK3528 uses DMA completion without a separate PDM interrupt description.
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: rockchip,rk3528-pdm
+    then:
+      required:
+        - interrupts
 
 properties:
   compatible:
-    enum:
-      - rockchip,pdm
-      - rockchip,px30-pdm
-      - rockchip,rk1808-pdm
-      - rockchip,rk3308-pdm
-      - rockchip,rk3568-pdm
-      - rockchip,rv1126-pdm
+    oneOf:
+      - enum:
+          - rockchip,pdm
+          - rockchip,px30-pdm
+          - rockchip,rk1808-pdm
+          - rockchip,rk3308-pdm
+          - rockchip,rk3568-pdm
+          - rockchip,rv1126-pdm
+      - items:
+          - const: rockchip,rk3528-pdm
+          - const: rockchip,rk3568-pdm
 
   reg:
     maxItems: 1
@@ -79,7 +93,6 @@
 required:
   - compatible
   - reg
-  - interrupts
   - clocks
   - clock-names
   - dmas
diff --git a/Documentation/devicetree/bindings/arm/rockchip.yaml b/Documentation/devicetree/bindings/arm/rockchip.yaml
--- a/Documentation/devicetree/bindings/arm/rockchip.yaml
+++ b/Documentation/devicetree/bindings/arm/rockchip.yaml
@@ -70,6 +70,11 @@
         items:
           - const: ariaboard,photonicat
           - const: rockchip,rk3568
+
+      - description: ZTE Cloud Computer W132D
+        items:
+          - const: zte,w132d
+          - const: rockchip,rk3528
 
       - description: ArmSoM Sige1 board
         items:
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -1762,6 +1762,8 @@
   "^ultrapower,.*":
     description: Beijing Ultrapower Software Co., Ltd.
+  "^unisoc,.*":
+    description: UNISOC Communications Inc.
   "^uni-t,.*":
     description: Uni-Trend Technology (China) Co., Ltd.
   "^uniwest,.*":
     description: United Western Technologies Corp (UniWest)
