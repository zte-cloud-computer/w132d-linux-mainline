[Unit]
Description=W132D IR/BLE power-key software standby
# 本版不含 HDMI：脚本里的 CEC Standby / DRM DPMS 两步在没有 HDMI 连接器时
# 会自行跳过（只记一条 warning），所以这里不再依赖 w132d-hdmi.service。
After=w132d-ir-keymap.service
Wants=w132d-ir-keymap.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/w132d-soft-standby --daemon
Restart=always
RestartSec=2
RuntimeDirectory=w132d-soft-standby
RuntimeDirectoryPreserve=restart
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
