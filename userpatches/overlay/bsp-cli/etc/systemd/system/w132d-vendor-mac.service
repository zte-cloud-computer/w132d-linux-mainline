# 开机把 vendor storage 里的出厂 MAC 设到有线网卡上，赶在 networkd 配网之前。
# 原理与格式见 /usr/local/sbin/w132d-vendor-mac 头部注释。
# 失败不阻塞开机：脚本读不到就只留一条警告、网卡用随机地址。
[Unit]
Description=W132D: set the factory Ethernet MAC from Rockchip vendor storage
DefaultDependencies=no
After=systemd-udevd.service local-fs.target
Before=network-pre.target systemd-networkd.service
Wants=network-pre.target
ConditionPathExists=/dev/mmcblk0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/w132d-vendor-mac --apply

[Install]
WantedBy=sysinit.target
