#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Select the update channel explicitly; downgrades require --downgrade."""
import argparse
import fcntl
import os
from pathlib import Path
import re
import subprocess

PACKAGES = ("linux-image-edge-rockchip64", "linux-dtb-edge-rockchip64", "linux-headers-edge-rockchip64",
            "linux-libc-dev-edge-rockchip64", "linux-u-boot-w132d-edge", "armbian-bsp-cli-w132d-edge")


def switch(root, channel):
    """Validate both administrator-owned conffiles before replacing either."""
    root = Path(root)
    source = root / "etc/apt/sources.list.d/w132d-experimental.sources"
    pin = root / "etc/apt/preferences.d/w132d-kernel"
    original = {source: source.read_text(), pin: pin.read_text()}
    enabled = "yes" if channel == "experimental" else "no"
    priority = "991" if channel == "experimental" else "-1"
    source_text, sources = re.subn(r"(?m)^Enabled:.*$", "Enabled: " + enabled, original[source])
    pin_text, pins = re.subn(r"(Pin: release o=W132D,a=experimental\nPin-Priority:) -?\d+",
                           r"\g<1> " + priority, original[pin])
    if sources != 1 or pins != 1:
        raise ValueError("Custom source or pin has no unique experimental rule; review it before switching")
    try:
        for path, text in ((source, source_text), (pin, pin_text)):
            temporary = path.with_name(path.name + ".tmp")
            temporary.write_text(text)
            temporary.chmod(path.stat().st_mode & 0o777)
            temporary.replace(path)
    except OSError:
        for path, text in original.items():
            path.write_text(text)
        raise


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("channel", choices=("stable", "experimental"))
    parser.add_argument("--downgrade", action="store_true", help="Install the stable package set, explicitly allowing downgrades")
    args = parser.parse_args(argv)
    if os.geteuid() != 0:
        parser.error("Run this command as root")
    if args.downgrade and args.channel != "stable":
        parser.error("--downgrade is supported only with stable")
    try:
        with Path("/run/lock/w132d-channel.lock").open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            switch(Path("/"), args.channel)
            subprocess.run(["apt-get", "update"], check=True)
            if args.downgrade:
                installed = []
                for name in PACKAGES:
                    query = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Status}", name], capture_output=True, text=True)
                    if query.returncode == 0 and query.stdout == "installed":
                        installed.append(name + "/stable")
                if installed:
                    subprocess.run(["apt-get", "install", "--allow-downgrades", *installed], check=True)
            else:
                print("Channel selected: " + args.channel)
                print("Run apt upgrade to install eligible updates. Installed packages are not automatically downgraded.")
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        parser.exit(1, f"ERROR: {error}\n")


if __name__ == "__main__":
    main()
