# LED failures must not stop other services.
[Unit]
Description=W132D panel LEDs (network + fault)
Documentation=file:/usr/lib/w132d/led-status
After=network.target

[Service]
Type=simple
ExecStart=/usr/lib/w132d/led-status
Restart=always
RestartSec=5
Nice=19
IOSchedulingClass=idle
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
