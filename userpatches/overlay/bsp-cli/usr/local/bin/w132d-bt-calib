#!/bin/bash
# SPDX-License-Identifier: MIT
# 给展锐 Marlin3 (UWE5622) 蓝牙控制器下发 PSKEY/RF 校准。
#
# Linux 的 sprdbt_tty / uwe5622_bsp_sdio 驱动没有实现原厂 HAL 的这一步
# （实测 hci0 up 全程 0 条厂商命令），控制器因此跑在未标定状态：射频功率表
# 用芯片默认值，链路余量不足。表现为 LE 建连 0x3e、监督超时掉线、加密中途断链。
#
# 时序取自 libbt-vendor-sprd.so 的 marlin3_init：
#   0xFCA0(176B pskey) --CC--> 0xFCA2(252B rf) --CC--> 0xFCA1(3B core enable)
# 必须在 hci 设备 DOWN 时用 HCI_CHANNEL_USER 独占下发——一旦 up，内核已缓存
# Read Local Version / Features / BD_ADDR，再发就是脏数据。
set -uo pipefail
DEV=${DEV:-hci0}
IDX=${DEV#hci}
P=/lib/firmware/uwe5622/bt_configure_pskey.ini
R=/lib/firmware/uwe5622/bt_configure_rf.ini
log() { echo "w132d-bt-calib: $*"; }

# 芯片上下电由 sprdbt_tty 在 /dev/ttyBT0 被打开/关闭时驱动：
#   hciconfig hci0 down  -> bluetooth_set_power block=1 -> WCN marlin power 0
# 而 hciconfig hci0 up 唤不醒已下电的芯片（Can't init device: timed out），
# 必须重新打开 ttyBT0。所以这里用「重启 btattach」来做确定性的上电，
# 而不是裸的 down/up —— 后者实测会把控制器卡在下电状态，只能重启 btattach 救回。
ATTACH=w132d-bluetooth.service

# ── 缺校准文件时降级，而不是失败 ──
# 本服务是 bluetooth.service 的硬 Requires：这里 exit 1 会让蓝牙整个起不来，
# 遥控器随之完全失效，而报错指向的是 bluetooth.service，不是真正的原因。
# 公开发布的镜像不含这两个厂商文件（无再分发授权，由用户从自己设备注入），
# 所以「没有它们」是一种预期状态，必须能启动，只是射频不标定。
# 未标定的后果见文件头：LE 建连 0x3e、监督超时掉线、加密中途断链 —— 蓝牙会
# 不稳，但有总比整条链路没有强，而且日志直接说清楚该去哪儿拿文件。
if [ ! -r "$P" ] || [ ! -r "$R" ]; then
  log "缺少 PSKEY/RF 校准文件，跳过校准 —— 蓝牙仍会启动，但射频未标定"
  [ -r "$P" ] || log "  缺: $P"
  [ -r "$R" ] || log "  缺: $R"
  log "  从本机 Android 的 vendor 分区 **etc/** 取（不是 etc/firmware/，那是另一套）"
  log "  pskey 两套大小都是 5,284 B，只能用 sha256 分辨；详见 docs/INSTALL.md"
  exit 0
fi

for _ in $(seq 1 30); do
  hciconfig "$DEV" >/dev/null 2>&1 && break
  sleep 1
done
hciconfig "$DEV" >/dev/null 2>&1 || { log "$DEV 未出现，校准失败"; exit 1; }

# 必须在动电源之前读地址：ini 里的 device_addr 是出厂占位值，
# 原样下发会改掉控制器身份、毁掉已有绑定。
ADDR=$(hciconfig "$DEV" | awk '/BD Address/{print $3}')
[ -n "$ADDR" ] || { log "读不到 BD 地址，放弃（不能拿占位地址下发）"; exit 1; }
log "适配器 $DEV  地址 $ADDR"

# 重启 attach：芯片下电再上电，hci 设备重建且停在 DOWN 状态，
# 正是下发 pskey 需要的时机（内核此时还没发过任何初始化命令）。
if ! systemctl restart "$ATTACH" 2>/dev/null; then
  log "重启 $ATTACH 失败"
  exit 1
fi
for _ in $(seq 1 20); do
  hciconfig "$DEV" >/dev/null 2>&1 && break
  sleep 1
done
hciconfig "$DEV" >/dev/null 2>&1 || { log "$ATTACH 重启后 $DEV 未出现"; exit 1; }
sleep 2

if /usr/local/bin/sprd_pskey -i "$IDX" -p "$P" -r "$R" -b "$ADDR" >/tmp/bt-calib.log 2>&1; then
  log "校准下发成功（三条 VSC 状态均为 0）"
else
  log "校准下发失败，详见 /tmp/bt-calib.log"
  tail -5 /tmp/bt-calib.log
  exit 1
fi

# 校准完成后【故意】把 hci0 留在 DOWN，交给 bluetoothd 经 mgmt 上电。
#
# 不能用 `hciconfig hci0 up`：它走 HCIDEVUP ioctl，而 net/bluetooth/hci_sync.c 的
#     hci_dev_open_sync():
#         if (!HCI_SETUP && !HCI_CONFIG && !HCI_UNCONFIGURED &&
#             !HCI_USER_CHANNEL && hci_dev_test_flag(hdev, HCI_MGMT))
#                 ret = hci_powered_update_sync(hdev);
# 要求 HCI_MGMT 已置位（即已有 mgmt 客户端）。ioctl 上电时没有，整段被跳过，
# 而 smp_register() 【只】在 hci_powered_update_sync() 里调用。后果链条：
#   SMP 固定通道 (CID 0x0006) 永不注册
#   -> 每条 LE 连接 conn->smp == NULL
#   -> smp_conn_security() 打 "security requested but not available" 并返回 1
#   -> l2cap_sock_setsockopt(BT_SECURITY) 回 EINVAL
#   -> bluetoothd device_attach_att() 中 bt_io_set 失败后 return false，ATT 不挂载
#   -> BLE 设备连上约 2 秒、零 ATT 流量后被本地拆链路；LE 配对也完全无法进行。
# 而且 bluetoothd 之后起来时 hci0 已是 HCI_UP 且 HCI_AUTO_OFF 未置位，
# hci_power_on_sync() 也不会补跑 powered_update —— 这个洞是永久性的。
#
# 也不在这里用 btmgmt：sprd_pskey 关掉 HCI_CHANNEL_USER 之后，mgmt index 要隔很久
# 才重新 added，btmgmt 会一直阻塞等它（实测每次吃满 timeout，开机被拖慢 200s+）。
# bluetoothd 的 [Policy] AutoEnable=true 会在它启动时上电，那才是正路。
# 兜底校验放在 w132d-ble-remote.service 的 ExecStartPre（那时 mgmt 一定活着）。
log "校准完成，hci0 保持 DOWN，交给 bluetoothd(AutoEnable) 经 mgmt 上电"

NEW=$(hciconfig "$DEV" | awk '/BD Address/{print $3}')
STATE=$(hciconfig "$DEV" | grep -o "UP RUNNING\|DOWN")
if [ "$NEW" != "$ADDR" ]; then
  log "地址从 $ADDR 变成了 ${NEW:-<empty>} —— 拒绝继续启动蓝牙"
  exit 1
else
  log "地址保持 $NEW，hci0 $STATE"
fi
exit 0
