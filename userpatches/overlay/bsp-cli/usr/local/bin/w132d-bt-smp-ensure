#!/bin/bash
# SPDX-License-Identifier: MIT
# 确认 LE 的 SMP 固定通道 (CID 0x0006) 已注册，再让 BLE 桥接启动（w132d-ble-remote.service 的 ExecStartPre）。
#
# smp_register() 只在 mgmt 客户端上电（hci_powered_update_sync）时跑；用 ioctl 上电（hciconfig hci0 up）
# 会让它缺席且事后补不上。症状：LE 能扫能连，但每条连接约 2 秒被本地拆掉、零 ATT 流量，
# dmesg 只有 "security requested but not available"。补救只能 btmgmt power off/on 一轮。
set -uo pipefail
DEV=${DEV:-hci0}
L2=/sys/kernel/debug/bluetooth/l2cap
log() { echo "w132d-bt-smp-ensure: $*"; }
smp_ok() { awk '$7=="0x0006"{f=1} END{exit !f}' "$L2"; }

if [ ! -r "$L2" ]; then
  log "$L2 不可读，无法证明 SMP 固定通道已注册"
  exit 1
fi

for _ in $(seq 1 30); do
  hciconfig "$DEV" 2>/dev/null | grep -q "UP RUNNING" && break
  sleep 1
done

if ! hciconfig "$DEV" 2>/dev/null | grep -q "UP RUNNING"; then
  log "$DEV 未上电，补一次 btmgmt power on"
  if ! timeout 25 btmgmt -i "$DEV" power on >/dev/null 2>&1; then
    log "btmgmt power on 失败"
    exit 1
  fi
  sleep 3
fi

if smp_ok; then
  log "SMP 固定通道 (CID 0x0006) 已注册"
  exit 0
fi

log "SMP 固定通道缺失，做一次 mgmt 上电循环补救"
if ! timeout 15 btmgmt -i "$DEV" power off >/dev/null 2>&1; then
  log "btmgmt power off 失败"
  exit 1
fi
sleep 2
if ! timeout 25 btmgmt -i "$DEV" power on >/dev/null 2>&1; then
  log "btmgmt power on 失败"
  exit 1
fi
sleep 3
if smp_ok; then
  log "已补救：SMP 固定通道注册成功"
else
  log "SMP 固定通道仍缺失 —— 拒绝启动 BLE 桥接"
  exit 1
fi
exit 0
