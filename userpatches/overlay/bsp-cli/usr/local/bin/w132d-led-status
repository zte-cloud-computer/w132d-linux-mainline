#!/bin/bash
# SPDX-License-Identifier: MIT
# W132D 面板指示灯守护进程（w132d-led-status.service）。
#
# 面板只有一颗双色灯（红+绿共位，pwr）；原厂 DTB 里的 net-red/net-green 引脚没有接实物，
# 脚本仍驱动它们，将来有硬件直接可用。
#
# 灯语（优先级：故障 > 预警 > 正常）：
#   红常亮    启动中（DT default-state=on）/ 关机中（本脚本退出时）
#   绿常亮    正常运行（静止不闪，用家明确不要闪）
#   绿慢闪    有 systemd 单元 failed（绿=用户态还活着）
#   红慢闪    SoC 温度 ≥85°C（热降频第一档是 95°C，是「注意」不是「出事」）
#   红绿同亮  内核 panic：panic 触发器只点红，绿还亮着，零代码且用户态死了照样有效
# 已知盲区：预警态下红灯被 timer 触发器占用，此时 panic 红灯只停在当时状态，接受。
# 网络状态不进 pwr 灯（用家指定），只驱动 lan 灯。
set -euo pipefail
IFACE="${W132D_LED_IFACE:-end0}"
L=/sys/class/leds
PG=$L/green:power
PR=$L/red:power
NG=$L/green:lan
NR=$L/red:lan
TEMP_WARN="${W132D_LED_TEMP_WARN:-85000}"   # 可用环境变量压低以便测试
BLINK_MS=1000
INTERVAL="${W132D_LED_INTERVAL:-2}"

w(){    [ -e "$1/brightness" ] && echo "$2" > "$1/brightness" 2>/dev/null || true; }
trig(){ [ -e "$1/trigger" ]    && echo "$2" > "$1/trigger"    2>/dev/null || true; }
blink(){ trig "$1" timer
         [ -e "$1/delay_on"  ] && echo "$BLINK_MS" > "$1/delay_on"  2>/dev/null || true
         [ -e "$1/delay_off" ] && echo "$BLINK_MS" > "$1/delay_off" 2>/dev/null || true; }

# 红灯交给内核的 panic 触发器：平时灭，panic 时亮。
# 顺序不能换 —— 见下方 case 里的说明。
arm_panic(){ trig "$PR" none; w "$PR" 0; trig "$PR" panic; }

# ── 启动完成：红灭、绿亮，并把 panic 触发器挂上 ──
# 先接管红灯（清掉 DT 的 default-state=on），再点绿灯。
arm_panic
w "$PG" 1

cleanup(){
  # 退出时别留下"一切正常"的假象：绿灭、红亮（= 关机中/服务挂了）
  trig "$PG" none; w "$PG" 0
  trig "$PR" none; w "$PR" 1
  w "$NG" 0; w "$NR" 0
  exit 0
}
trap cleanup TERM INT EXIT

state=""   # 只在状态变化时动灯，避免每 2 秒重复写 sysfs
while :; do
  failed=$(systemctl list-units --state=failed --no-legend 2>/dev/null | wc -l)
  temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)
  link=0
  [ "$(cat /sys/class/net/$IFACE/carrier 2>/dev/null || echo 0)" = "1" ] && link=1

  if   [ "$failed" -gt 0 ];          then new=fault   # 🟢 绿慢闪
  elif [ "$temp" -ge "$TEMP_WARN" ]; then new=warn    # 🔴 红慢闪
  else                                    new=ok      # 🟢 绿常亮
  fi

  if [ "$new" != "$state" ]; then
    case "$new" in
      # 每个分支都把两颗灯写全，别依赖上一个状态残留
      # ⚠️ 红灯必须「先 none、再灭、最后挂 panic」：内核 brightness_store() 在
      #    写入 0 时会调 led_trigger_remove()，先挂触发器再写 0 会把它悄悄摘掉。
      fault) arm_panic;             blink "$PG" ;;                       # 绿慢闪，红仍守着 panic
      warn)  trig "$PG" none;  w "$PG" 0; blink "$PR" ;;                 # 红慢闪、绿灭
      ok)    trig "$PG" none;  w "$PG" 1; arm_panic ;;                   # 绿常亮，红交回 panic
    esac
    state="$new"
  fi

  # lan 灯：目前无实物，逻辑保留（将来有硬件直接可用）
  w "$NG" "$link"
  w "$NR" $((1 - link))

  sleep "$INTERVAL"
done
