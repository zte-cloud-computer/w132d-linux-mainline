#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""有线网卡 MAC 的兜底：U-Boot 没往 DT 里写 local-mac-address 时，按 SoC OTP 派生一个固定地址。

## 正常路径不经过这里

主线 U-Boot 的 misc_init_r 按 OTP cpuid 派生一个固定地址（rockchip_setup_macaddr），起内核时
按 ethernet0 别名写进 DT（local-mac-address）。内核从 DT 拿到地址，网卡开机就是对的。
出厂 MAC 不抢救（2026-09-05 定案：整盘刷写把 vendor storage 一并清零）。这个服务只在 DT 里**没有** MAC 时才动手 ——
比如 U-Boot 被换成不做这件事的版本 —— 避免退化成"每次开机随机地址"。

派生：sha256("w132d-mac:" + OTP nvmem 内容，退而求其次 eMMC CID) 取 6 字节，置本地管理位、
清组播位。每台机器固定、不同机器不同；与 U-Boot 派生出的值不相等（算法不同），但同样稳定。

用法：
    w132d-vendor-mac            只报告（DT 里有没有、派生值是多少）
    w132d-vendor-mac --apply    DT 里没有时设到 rk_gmac-dwmac 驱动的第一块网卡上
读不到时打印警告并退出 0：这是锦上添花，不能把开机卡住。
"""
import glob
import hashlib
import os
import subprocess
import sys


def dt_mac():
    """DT 里 gmac 节点的 local-mac-address / mac-address（U-Boot 注入的）"""
    for node in glob.glob("/proc/device-tree/soc/ethernet@*") + glob.glob("/proc/device-tree/ethernet@*"):
        for prop in ("local-mac-address", "mac-address"):
            p = os.path.join(node, prop)
            try:
                with open(p, "rb") as f:
                    b = f.read()
            except OSError:
                continue
            if len(b) == 6 and any(b):
                return b
    return None


def derived_mac():
    for src, tag in (("/sys/bus/nvmem/devices/rockchip-otp0/nvmem", "otp"),
                     ("/sys/block/mmcblk0/device/cid", "emmc-cid")):
        try:
            with open(src, "rb") as f:
                blob = f.read().strip()
        except OSError:
            continue
        if not blob or not any(blob):
            continue
        h = hashlib.sha256(b"w132d-mac:" + blob).digest()
        return bytes([(h[0] | 0x02) & 0xFE]) + h[1:6], tag
    return None, None


def fmt(b):
    return ":".join("%02x" % x for x in b)


def gmac_ifaces():
    out = []
    for name in sorted(os.listdir("/sys/class/net")):
        drv = os.path.join("/sys/class/net", name, "device", "driver")
        if os.path.islink(drv) and os.path.basename(os.readlink(drv)) == "rk_gmac-dwmac":
            out.append(name)
    return out


def main():
    apply_ = "--apply" in sys.argv
    ifs = gmac_ifaces()
    dev = ifs[0] if ifs else None
    cur = open(f"/sys/class/net/{dev}/address").read().strip() if dev else "?"
    m = dt_mac()
    if m:
        print(f"  DT 里有 MAC {fmt(m)}（U-Boot 注入），{dev or '网卡'} 当前 {cur}，不动")
        return 0
    mac, tag = derived_mac()
    if not mac:
        print("w132d-vendor-mac: DT 里没有 MAC，也派生不出来，网卡保持现状", file=sys.stderr)
        return 0
    print(f"  DT 里没有 MAC；派生自 {tag}：{fmt(mac)}")
    if not apply_ or not dev:
        return 0
    if cur == fmt(mac):
        print(f"  {dev} 已是 {cur}")
        return 0
    subprocess.run(["ip", "link", "set", "dev", dev, "down"], check=False)
    r = subprocess.run(["ip", "link", "set", "dev", dev, "address", fmt(mac)])
    print(f"  {dev}: {cur} -> {fmt(mac)} ({'ok' if r.returncode == 0 else 'failed'})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
