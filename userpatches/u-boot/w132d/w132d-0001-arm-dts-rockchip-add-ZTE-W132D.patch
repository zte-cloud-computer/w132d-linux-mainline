From: wenziwanka <tech@wenziwanka.com>
Subject: [PATCH] rockchip: support W132D and its SARADC download key

Use a minimal U-Boot board tree for eMMC, UART and the download key.
Match the RK3528 ADC by compatible so the native adc node can be reused.
Linux receives its own separately maintained DTB through extlinux.

diff --git a/arch/arm/dts/rk3528-w132d.dts b/arch/arm/dts/rk3528-w132d.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm/dts/rk3528-w132d.dts
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * ZTE Cloud Computer W132D (Rockchip RK3528).
+ *
+ * U-Boot-only device tree: eMMC, UART0 console and the SARADC download key
+ * (the Reset pinhole next to HDMI is SARADC channel 1, ~10 when pressed,
+ * ~1019 idle). Linux gets its own DTB through extlinux.
+ */
+
+/dts-v1/;
+#include "rk3528.dtsi"
+
+/ {
+	model = "ZTE Cloud Computer W132D";
+	compatible = "zte,w132d", "rockchip,rk3528";
+
+	aliases {
+		mmc0 = &sdhci;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:1500000n8";
+	};
+
+	vdd_1v8_s3: regulator-vdd-1v8-s3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_1v8_s3";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+	};
+};
+
+&saradc {
+	vref-supply = <&vdd_1v8_s3>;
+	status = "okay";
+};
+
+&sdhci {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	no-sd;
+	no-sdio;
+	non-removable;
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0m0_xfer>;
+	status = "okay";
+};
diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -51,7 +51,8 @@
 
 	ret = -ENODEV;
 	uclass_foreach_dev(dev, uc) {
-		if (!strncmp(dev->name, "saradc", 6)) {
+		if (device_is_compatible(dev, "rockchip,rk3528-saradc") ||
+		    !strncmp(dev->name, "saradc", 6)) {
 			ret = adc_channel_single_shot(dev->name, 1, &val);
 			break;
 		}
